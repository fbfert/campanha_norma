NODE_ENV=development
HOST=127.0.0.1
PORT=3100

SERVICE_TOKEN=
SERVICE_NAME=whatsapp-service

SESSION_PATH=/var/lib/gerenciador-whatsapp/session
LOG_PATH=/var/log/gerenciador-whatsapp

BROWSER_HEADLESS=true
BROWSER_EXECUTABLE_PATH=
BROWSER_NO_SANDBOX=false

# Pino em uma build especifica do WhatsApp Web (wa-version) para evitar
# incompatibilidades entre a versao mais recente do WhatsApp Web e a
# whatsapp-web.js. Atualize quando a whatsapp-web.js publicar suporte a uma
# build mais nova. Formato: html de https://github.com/wppconnect-team/wa-version
WEB_VERSION_CACHE_URL=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/2.3000.1040225260-alpha.html

REQUEST_TIMEOUT_MS=15000
QR_EXPIRATION_SECONDS=60
MAX_RECONNECT_ATTEMPTS=5
RECONNECT_INTERVAL_SECONDS=15

ALLOW_TEST_MESSAGE=true

LARAVEL_INCOMING_WEBHOOK_URL=https://mensagens.exemplo.com/internal/whatsapp/incoming
LARAVEL_INCOMING_WEBHOOK_SECRET=
LARAVEL_INCOMING_WEBHOOK_TIMEOUT_MS=10000
INCOMING_WEBHOOK_MAX_ATTEMPTS=5
INCOMING_WEBHOOK_RETRY_SECONDS=15
INCOMING_MESSAGE_ENABLED=true
INCOMING_MESSAGE_LOG_BODY=false
